@namespace DelegationStation.Shared

@if (!string.IsNullOrEmpty(Message))
{
    <div class="maintenance-banner @(HasCustomColor ? "" : "maintenance-banner-default")" style="@BannerStyle" role="alert">
        @if (IsScrolling)
        {
            <div class="maintenance-banner-track">
                <span class="maintenance-banner-text" style="animation-duration:@(ScrollDurationSeconds)s">@Message</span>
            </div>
        }
        else
        {
            <span class="maintenance-banner-text">@Message</span>
        }
    </div>
}
